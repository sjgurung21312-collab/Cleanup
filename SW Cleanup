@echo off
title SW CLEANUP - System Cleaner
color 0B
mode con cols=80 lines=35

echo.
echo   ======================================================
echo                    S W   C L E A N U P
echo                 System Cleanup Utility
echo   ======================================================
echo.
echo   Starting cleanup process...
echo.
timeout /t 2 >nul

::---------------------------------------------
:: Get Free Space Before
::---------------------------------------------
echo   [INFO] Checking free space on C: drive...
for /f "tokens=3" %%a in ('dir /-c C:\ ^| find "bytes free"') do set FreeBefore=%%a
echo   Free Space before cleanup: %FreeBefore% bytes
echo.
timeout /t 1 >nul

::---------------------------------------------
:: 1. Delete Temp Files
::---------------------------------------------
echo   [1/5] Deleting Temporary Files...
echo         Cleaning User Temp folder...
del /s /f /q "%temp%\*.*" >nul 2>&1
echo         Cleaning Windows Temp folder...
del /s /f /q "C:\Windows\Temp\*.*" >nul 2>&1
echo         Cleaning Prefetch...
del /s /f /q "C:\Windows\Prefetch\*.*" >nul 2>&1
echo   [OK] Temporary files deleted.
echo.
timeout /t 1 >nul

::---------------------------------------------
:: 2. Empty Recycle Bin
::---------------------------------------------
echo   [2/5] Emptying Recycle Bin...
rd /s /q C:\$Recycle.Bin >nul 2>&1
echo   [OK] Recycle Bin emptied.
echo.
timeout /t 1 >nul

::---------------------------------------------
:: 3. Temporary Internet Files
::---------------------------------------------
echo   [3/5] Cleaning Temporary Internet Files...
del /s /f /q "%LocalAppData%\Microsoft\Windows\INetCache\*.*" >nul 2>&1
echo   [OK] Temporary Internet Files cleaned.
echo.
timeout /t 1 >nul

::---------------------------------------------
:: 4. Browser Cleanup
::---------------------------------------------
echo   [4/5] Cleaning Browser Data...
echo.

echo         - Cleaning Internet Explorer...
RunDll32.exe InetCpl.cpl,ClearMyTracksByProcess 255 >nul 2>&1
echo           IE cleaned.

echo         - Cleaning Google Chrome...
taskkill /F /IM chrome.exe >nul 2>&1
timeout /t 1 >nul
del /s /f /q "%LocalAppData%\Google\Chrome\User Data\Default\Cache\*.*" >nul 2>&1
del /s /f /q "%LocalAppData%\Google\Chrome\User Data\Default\Code Cache\*.*" >nul 2>&1
del /s /f /q "%LocalAppData%\Google\Chrome\User Data\Default\History*" >nul 2>&1
echo           Chrome cleaned.

echo         - Cleaning Mozilla Firefox...
taskkill /F /IM firefox.exe >nul 2>&1
timeout /t 1 >nul
for /d %%i in ("%AppData%\Mozilla\Firefox\Profiles\*") do (
    del /s /f /q "%%i\cache2\*.*" >nul 2>&1
    del /s /f /q "%%i\cookies.sqlite" >nul 2>&1
)
echo           Firefox cleaned.
echo.
echo   [OK] Browser cleanup finished.
echo.
timeout /t 1 >nul

::---------------------------------------------
:: 5. Final Space Check
::---------------------------------------------
echo   [5/5] Checking free space after cleanup...
for /f "tokens=3" %%a in ('dir /-c C:\ ^| find "bytes free"') do set FreeAfter=%%a
echo.
echo   ======================================================
echo                     CLEANUP SUMMARY
echo   ======================================================
echo   Free Space before : %FreeBefore% bytes
echo   Free Space after  : %FreeAfter% bytes
echo   ======================================================
echo.
echo   [SUCCESS] SW CLEANUP completed successfully!
echo.
echo   Press any key to exit...
pause >nul
exit
